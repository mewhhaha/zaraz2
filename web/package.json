    "dev": "wrangler dev --live-reload"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.14",
    "@cloudflare/workers-types": "^4.20251014.0",
    "@mewhhaha/eslint-plugin-simple-tailwind": "^0.0.15",
    "@mewhhaha/eslint-plugin-url-exists": "workspace:*",
    "@mewhhaha/ruwuter": "jsr:^0.1.22",
    "@prettier/plugin-oxc": "^0.0.4",
    "@tailwindcss/node": "^4.1.15",
    "@tailwindcss/oxide": "^4.1.15",
    "@tailwindcss/vite": "^4.1.15",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.9.1",
    "eslint": "^9.38.0",
    "eslint-plugin-better-tailwindcss": "^3.7.10",
    "eslint-plugin-oxlint": "^1.23.0",
    "fast-glob": "^3.3.3",
    "lightningcss": "^1.30.2",
    "npm-run-all": "^4.1.5",
    "oxlint": "^1.23.0",
    "prettier": "4.0.0-alpha.12",
    "rolldown": "1.0.0-beta.44",
    "tailwindcss": "^4.1.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "npm:rolldown-vite@latest",
    "vitest": "^3.2.4",
    "wrangler": "^4.44.0"
