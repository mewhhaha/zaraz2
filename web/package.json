{
  "name": "worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "test": "vitest",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint app",
